{
  "name": "authora",
  "displayName": "Authora — 2FA Authenticator",
  "description": "Password-protected two-factor authenticator (TOTP/HOTP/Steam) in your VS Code sidebar. Encrypted vault, no cloud, no telemetry.",
  "version": "0.2.0",
  "publisher": "NiravPatel15",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies",
    "test:integration": "npm run build && test/integration/run.sh ${TMPDIR:-/tmp}/authora-it"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.5",
    "crypto-js": "4.2.0",
    "hash-wasm": "4.12.0",
    "jsqr": "1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/crypto-js": "4.2.2",
    "@types/node": "20.17.6",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "5.6.3",
    "vitest": "4.1.12"
  },
  "icon": "media/icon.png",
  "keywords": [
    "2fa",
    "totp",
    "authenticator",
    "otp",
    "mfa",
    "two-factor",
    "google authenticator",
    "vault",
    "hotp",
    "steam"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "authora",
          "title": "Authora",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "authora": [
        {
          "type": "webview",
          "id": "authora.accounts",
          "name": "Accounts"
        }
      ]
    },
    "commands": [
      {
        "command": "authora.open",
        "title": "Open",
        "category": "Authora",
        "icon": "$(shield)"
      },
      {
        "command": "authora.unlock",
        "title": "Unlock Vault",
        "category": "Authora",
        "icon": "$(unlock)"
      },
      {
        "command": "authora.lock",
        "title": "Lock Vault",
        "category": "Authora",
        "icon": "$(lock)"
      },
      {
        "command": "authora.copyCode",
        "title": "Copy Code…",
        "category": "Authora",
        "icon": "$(copy)"
      },
      {
        "command": "authora.insertCode",
        "title": "Insert Code into Editor…",
        "category": "Authora"
      },
      {
        "command": "authora.addFromUri",
        "title": "Add Account from otpauth:// Link…",
        "category": "Authora"
      },
      {
        "command": "authora.import",
        "title": "Import Backup File…",
        "category": "Authora"
      },
      {
        "command": "authora.exportBackup",
        "title": "Export Encrypted Backup…",
        "category": "Authora"
      },
      {
        "command": "authora.chooseBackupFolder",
        "title": "Choose Auto-Backup Folder…",
        "category": "Authora"
      },
      {
        "command": "authora.changePassword",
        "title": "Change Master Password…",
        "category": "Authora"
      },
      {
        "command": "authora.syncClock",
        "title": "Sync Clock with Server",
        "category": "Authora"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "authora.lock",
          "when": "view == authora.accounts",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "authora.copyCode",
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2"
      }
    ],
    "configuration": {
      "title": "Authora",
      "properties": {
        "authora.autoLockMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "description": "Lock the vault after this many minutes without interaction. 0 = never (not recommended).",
          "scope": "application"
        },
        "authora.clipboardClearSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Clear a copied code from the clipboard after this many seconds (only if it is still there). 0 = never.",
          "scope": "application"
        },
        "authora.rememberOnThisMachine": {
          "type": "boolean",
          "default": false,
          "description": "Store the vault key in the OS keychain so the vault opens without a password after restart.",
          "scope": "application"
        },
        "authora.autoBackupFolder": {
          "type": "string",
          "default": "",
          "description": "Folder that receives an encrypted backup after every change (opens with your master password). Use a Dropbox/Drive/OneDrive folder for cloud sync.",
          "scope": "application"
        },
        "authora.backupKeep": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "How many auto-backup files to keep.",
          "scope": "application"
        },
        "authora.hideCodes": {
          "type": "boolean",
          "default": false,
          "description": "Blur codes until you hover over them.",
          "scope": "application"
        }
      }
    }
  },
  "preview": false,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NIRAV-PATEL-15/authora.git"
  },
  "bugs": {
    "url": "https://github.com/NIRAV-PATEL-15/authora/issues"
  },
  "homepage": "https://github.com/NIRAV-PATEL-15/authora#readme",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}

{
  "name": "vault-2fa",
  "displayName": "Vault 2FA",
  "description": "Password-protected two-factor authenticator (TOTP/HOTP/Steam/Battle.net) inside VS Code.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "crypto-js": "4.2.0",
    "hash-wasm": "4.12.0",
    "jsqr": "1.4.0"
  },
  "devDependencies": {
    "@types/crypto-js": "4.2.2",
    "@types/node": "20.17.6",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
